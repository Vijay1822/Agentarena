# ==============================================================================
# SentinelZero — AI Cyber Detective Participant Configuration (.env)
# ==============================================================================

# Runtime Mode: 'practice' (local mock simulator) or 'submission' (live arena)
MODE=practice

# ------------------------------------------------------------------------------
# Practice Mode (Local Mock Simulator: http://127.0.0.1:8001)
# ------------------------------------------------------------------------------
PRACTICE_ARENA_URL=http://127.0.0.1:8001
PRACTICE_BEARER_TOKEN=dev-practice-token

# ------------------------------------------------------------------------------
# Submission Mode (Official Competition Arena Platform)
# URL: Public ingress provided by competition organizers, or http://localhost:8000 for local docker
# Paste the bearer token assigned to your team upon registration
# ------------------------------------------------------------------------------
SUBMISSION_ARENA_URL=https://plentiful-approve-prompter.ngrok-free.dev
SUBMISSION_BEARER_TOKEN=a0zqnvDT

# ------------------------------------------------------------------------------
# Google Gemini API Keys (Optional but Recommended for LLM Agents)
# Configure up to 5 keys for automatic round-robin rotation across sequential tasks.
# This prevents 429 quota exhaustion and ensures smooth continuous evaluation.
# ------------------------------------------------------------------------------
GOOGLE_API_KEY_1="AQ.Ab8RN6K-8zOhwE0AkjTdqxiEgxhoWPnUhFvjcGl4MMRkFDjuNg"
GOOGLE_API_KEY_2=your_google_api_key_2
GOOGLE_API_KEY_3=your_google_api_key_3
GOOGLE_API_KEY_4=your_google_api_key_4
GOOGLE_API_KEY_5=your_google_api_key_5

# Target Gemini Model Name (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Custom Gemini Gateway / Base URL (optional, leave commented to use official endpoint)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
